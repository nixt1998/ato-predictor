# 邮件配置（用于数据上传通知）
# 163 邮箱需要开启 SMTP 授权码，不是登录密码
# 开启方法：邮箱设置 → POP3/SMTP/IMAP → 开启SMTP服务 → 获取授权码
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=nixt1998@163.com
SMTP_PASSWORD=your_smtp_authorization_code_here
SMTP_FROM=nixt1998@163.com
SMTP_TO=nixt1998@163.com

# 上传文件保存路径（阿里云服务器上的绝对路径）
UPLOAD_DIR=/data/uploads

# R Shiny API 地址（可选）
NEXT_PUBLIC_R_API_URL=http://localhost:8000
